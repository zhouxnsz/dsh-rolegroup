{
  "name": "dsh-rolegroup",
  "version": "0.6.1",
  "description": "角色化委派插件：把「这类活该用哪个模型」固化为角色（名字 + 绑定模型 + persona），按角色名委派 · Role-based delegation: bind each kind of work to a model once and delegate by role name",
  "icon": "assets/icon.svg",
  "license": "MIT",
  "author": "Zhou.XiaoNing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouxnsz/dsh-rolegroup.git"
  },
  "homepage": "https://github.com/zhouxnsz/dsh-rolegroup#readme",
  "bugs": {
    "url": "https://github.com/zhouxnsz/dsh-rolegroup/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "roles",
    "subagent",
    "delegation"
  ],
  "main": "lib/index.js",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "assets/icon.svg"
  ],
  "scripts": {
    "link:deps": "node scripts/link-deployment-deps.mjs",
    "pretest": "node scripts/link-deployment-deps.mjs",
    "test": "node tests/smoke.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "npm run build:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "private": false,
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
